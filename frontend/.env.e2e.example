# Application endpoints
E2E_BASE_URL=http://127.0.0.1:3000
E2E_API_BASE_URL=http://127.0.0.1:4000/api

# Set to false when testing an already-running or deployed environment.
E2E_START_WEB_SERVERS=true
E2E_REUSE_EXISTING_SERVER=true

# Optional dedicated E2E database. When set, it is passed to the backend as DATABASE_URL.
E2E_DATABASE_URL=

# Test accounts. Keep real credentials only in .env.e2e or CI secrets.
ADMIN_EMAIL=
ADMIN_PASSWORD=
LECTURER_EMAIL=
LECTURER_PASSWORD=
STUDENT_EMAIL=
STUDENT_PASSWORD=
