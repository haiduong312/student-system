# Application endpoints
E2E_BASE_URL=http://localhost:3000
E2E_API_BASE_URL=http://localhost:4000/api

# Set to false when testing an already-running or deployed environment.
E2E_START_WEB_SERVERS=true
E2E_REUSE_EXISTING_SERVER=true

# Optional dedicated E2E database. When set, it is passed to the backend as DATABASE_URL.
E2E_DATABASE_URL=postgresql://nguyenhaiduong@localhost:5432/student_system?schema=public


# Test accounts. Keep real credentials only in .env.e2e or CI secrets.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
LECTURER_EMAIL=lecturer@example.com
LECTURER_PASSWORD=Lecturer@123
STUDENT_EMAIL=student.backend@example.com
STUDENT_PASSWORD=Student@123
