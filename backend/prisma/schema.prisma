// Student Digital Competency Profile & Personal Development Roadmap
// PostgreSQL database schema for NestJS + Prisma.
//
// Module layout:
// - Auth/User: User, Student, Lecturer, AdvisorAssignment
// - Skill: SkillCategory, Skill
// - Career Goal: CareerGoal, CareerRequiredSkill
// - Student Profile: StudentProfile, StudentSkill, StudentProject, StudentCertificate,
//   StudentActivity, StudentExperience, Evidence, AdvisorReview
// - Recommendation: RecommendationTemplate, StudentRecommendation
// - Roadmap: DevelopmentRoadmap, RoadmapItem, StudentRoadmapProgress
// - Notification: Notification, NotificationLog
// - Audit/Export: ActivityLog, ExportLog

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  LECTURER
  STUDENT
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

enum VerificationStatus {
  NO_EVIDENCE
  PENDING
  VERIFIED
  REJECTED
}

enum EvidenceEntityType {
  SKILL
  PROJECT
  CERTIFICATE
  ACTIVITY
  EXPERIENCE
  ROADMAP_ITEM
}

enum EvidenceStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchLevel {
  NOT_MATCHED
  DEVELOPING
  GOOD_MATCH
  STRONG_MATCH
}

enum SkillLevel {
  ZERO
  BASIC
  INTERMEDIATE
  GOOD
}

enum SkillType {
  COMMON
  CAREER_SPECIFIC
}

enum QuestionType {
  SINGLE_CHOICE
  TRUE_FALSE
}

enum QuestionStatus {
  ACTIVE
  INACTIVE
}

enum AssessmentStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  CANCELLED
}

enum AnalysisSkillStatus {
  ACHIEVED
  MISSING
  NEED_IMPROVEMENT
}

enum RecommendationType {
  COURSE
  PROJECT
  CERTIFICATE
  PRACTICE
  DOCUMENT
  PORTFOLIO_TASK
}

enum LearningResourceType {
  COURSE
  VIDEO
  DOCUMENT
  ARTICLE
  BOOK
  PRACTICE
  PROJECT
  CERTIFICATE
  TOOL
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RoadmapPhase {
  CORE_FOUNDATION
  CAREER_TRACK
  SPECIALIZATION
  PRACTICE_PROJECT
  PORTFOLIO_PREPARATION
}

enum TemplateStatus {
  ACTIVE
  INACTIVE
}

enum StudentRecommendationStatus {
  NEW
  SAVED
  IN_PROGRESS
  DONE
  DISMISSED
}

enum ResourceProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum RoadmapStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
  CANCELLED
}

enum RoadmapItemType {
  LEARN
  PRACTICE
  PROJECT
  CERTIFICATE
  PORTFOLIO
}

enum RoadmapItemStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NotificationType {
  PROFILE_REMINDER
  EVIDENCE_VERIFIED
  EVIDENCE_REJECTED
  ROADMAP_REMINDER
  ADVISOR_REVIEW
  WEAK_PROFILE_ALERT
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationLogStatus {
  PENDING
  SENT
  FAILED
}

enum ExportType {
  STUDENT_PORTFOLIO_PDF
  STUDENTS_EXCEL
  COMPETENCY_EXCEL
  LECTURER_STUDENTS_EXCEL
}

// ---------------------------------------------------------------------------
// Auth & User Module
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  fullName         String    @map("full_name") @db.VarChar(150)
  email            String    @unique(map: "users_email_unique") @db.VarChar(191)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  refreshTokenHash String?   @map("refresh_token_hash") @db.VarChar(255)
  role             UserRole
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  student                    Student?
  lecturer                   Lecturer?
  assignedAdvisorAssignments AdvisorAssignment[] @relation("AdvisorAssignmentAssignedBy")
  verifiedStudentSkills      StudentSkill[]      @relation("StudentSkillVerifiedBy")
  reviewedEvidences          Evidence[]          @relation("EvidenceReviewedBy")
  notifications              Notification[]
  notificationLogs           NotificationLog[]
  activityLogs               ActivityLog[]
  exportLogs                 ExportLog[]

  @@index([role], map: "users_role_idx")
  @@map("users")
}

model Student {
  id           String    @id @default(cuid())
  userId       String    @unique(map: "students_user_id_unique") @map("user_id")
  studentCode  String    @unique(map: "students_student_code_unique") @map("student_code") @db.VarChar(50)
  className    String?   @map("class_name") @db.VarChar(100)
  major        String?   @db.VarChar(150)
  academicYear String?   @map("academic_year") @db.VarChar(20)
  phone        String?   @db.VarChar(30)
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisorAssignments AdvisorAssignment[]
  profile            StudentProfile?
  skills             StudentSkill[]
  projects           StudentProject[]
  certificates       StudentCertificate[]
  activities         StudentActivity[]
  experiences        StudentExperience[]
  evidences          Evidence[]
  analysisResults    CompetencyAnalysisResult[]
  recommendations    StudentRecommendation[]
  roadmaps           DevelopmentRoadmap[]
  roadmapProgress    StudentRoadmapProgress[]
  resourceProgress   StudentResourceProgress[]
  advisorReviews     AdvisorReview[]
  assessments        Assessment[]

  @@index([className, major], map: "students_class_major_idx")
  @@index([major, academicYear], map: "students_major_academic_year_idx")
  @@index([createdAt], map: "students_created_at_idx")
  @@map("students")
}

model Lecturer {
  id            String   @id @default(cuid())
  userId        String   @unique(map: "lecturers_user_id_unique") @map("user_id")
  lecturerCode  String   @unique(map: "lecturers_lecturer_code_unique") @map("lecturer_code") @db.VarChar(50)
  department    String?  @db.VarChar(150)
  phone         String?  @db.VarChar(30)
  academicTitle String?  @map("academic_title") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisorAssignments AdvisorAssignment[]
  advisorReviews     AdvisorReview[]

  @@index([department], map: "lecturers_department_idx")
  @@index([createdAt], map: "lecturers_created_at_idx")
  @@map("lecturers")
}

model AdvisorAssignment {
  id           String           @id @default(cuid())
  lecturerId   String           @map("lecturer_id")
  studentId    String           @map("student_id")
  assignedById String?          @map("assigned_by")
  assignedAt   DateTime         @default(now()) @map("assigned_at")
  status       AssignmentStatus @default(ACTIVE)

  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("AdvisorAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([lecturerId, studentId], map: "advisor_assignments_lecturer_student_unique")
  @@index([studentId, status], map: "advisor_assignments_student_status_idx")
  @@index([lecturerId, status], map: "advisor_assignments_lecturer_status_idx")
  @@index([assignedAt], map: "advisor_assignments_assigned_at_idx")
  @@map("advisor_assignments")
}

// ---------------------------------------------------------------------------
// Skill Module
// ---------------------------------------------------------------------------

model SkillCategory {
  id           String        @id @default(cuid())
  name         String        @unique(map: "skill_categories_name_unique") @db.VarChar(150)
  description  String?       @db.Text
  roadmapPhase RoadmapPhase? @map("roadmap_phase")
  status       CatalogStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  skills                  Skill[]
  recommendationTemplates RecommendationTemplate[]

  @@index([status, name], map: "skill_categories_status_name_idx")
  @@index([roadmapPhase, status], map: "skill_categories_phase_status_idx")
  @@map("skill_categories")
}

model Skill {
  id                   String        @id @default(cuid())
  categoryId           String?       @map("category_id")
  name                 String        @db.VarChar(150)
  description          String?       @db.Text
  type                 SkillType     @default(CAREER_SPECIFIC)
  defaultRequiredLevel Int           @default(1) @map("default_required_level")
  defaultWeight        Decimal       @default(1) @map("default_weight") @db.Decimal(6, 2)
  status               CatalogStatus @default(ACTIVE)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  category                SkillCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  careerRequiredSkills    CareerRequiredSkill[]
  studentSkills           StudentSkill[]
  analysisDetails         CompetencyAnalysisDetail[]
  recommendationTemplates RecommendationTemplate[]
  studentRecommendations  StudentRecommendation[]
  roadmapItems            RoadmapItem[]
  assessmentQuestions     AssessmentQuestion[]
  assessmentItems         AssessmentQuestionItem[]
  assessmentSkillResults  AssessmentSkillResult[]
  learningResourceSkills  LearningResourceSkill[]

  @@unique([categoryId, name], map: "skills_category_name_unique")
  @@index([name], map: "skills_name_idx")
  @@index([categoryId, status], map: "skills_category_status_idx")
  @@index([type, status], map: "skills_type_status_idx")
  @@map("skills")
}

// ---------------------------------------------------------------------------
// Assessment Question Bank Module
// ---------------------------------------------------------------------------

model AssessmentQuestion {
  id           String         @id @default(cuid())
  skillId      String         @map("skill_id")
  questionText String         @map("question_text") @db.Text
  questionType QuestionType   @map("question_type")
  level        Int
  explanation  String?        @db.Text
  status       QuestionStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  skill           Skill                    @relation(fields: [skillId], references: [id], onDelete: Restrict)
  options         AssessmentOption[]
  assessmentItems AssessmentQuestionItem[]
  answers         AssessmentAnswer[]

  @@index([skillId, status], map: "assessment_questions_skill_status_idx")
  @@index([questionType, status], map: "assessment_questions_type_status_idx")
  @@index([level, status], map: "assessment_questions_level_status_idx")
  @@index([createdAt], map: "assessment_questions_created_at_idx")
  @@map("assessment_questions")
}

model AssessmentOption {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  optionText String   @map("option_text") @db.Text
  isCorrect  Boolean  @default(false) @map("is_correct")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AssessmentAnswer[]

  @@index([questionId, orderIndex], map: "assessment_options_question_order_idx")
  @@map("assessment_options")
}

// ---------------------------------------------------------------------------
// Assessment Module
// ---------------------------------------------------------------------------

model Assessment {
  id           String           @id @default(cuid())
  studentId    String           @map("student_id")
  careerGoalId String           @map("career_goal_id")
  status       AssessmentStatus @default(IN_PROGRESS)
  startedAt    DateTime         @default(now()) @map("started_at")
  submittedAt  DateTime?        @map("submitted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  student      Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  careerGoal   CareerGoal               @relation(fields: [careerGoalId], references: [id], onDelete: Restrict)
  items        AssessmentQuestionItem[]
  answers      AssessmentAnswer[]
  skillResults AssessmentSkillResult[]

  @@index([studentId, status, createdAt], map: "assessments_student_status_created_idx")
  @@index([careerGoalId, status], map: "assessments_career_goal_status_idx")
  @@map("assessments")
}

model AssessmentAnswer {
  id               String   @id @default(cuid())
  assessmentId     String   @map("assessment_id")
  questionId       String   @map("question_id")
  selectedOptionId String   @map("selected_option_id")
  isCorrect        Boolean  @default(false) @map("is_correct")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  assessment     Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question       AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption AssessmentOption   @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, questionId], map: "assessment_answers_assessment_question_unique")
  @@index([assessmentId], map: "assessment_answers_assessment_idx")
  @@index([questionId], map: "assessment_answers_question_idx")
  @@map("assessment_answers")
}

model AssessmentSkillResult {
  id               String   @id @default(cuid())
  assessmentId     String   @map("assessment_id")
  skillId          String   @map("skill_id")
  calculatedLevel  Int      @map("calculated_level")
  totalQuestions   Int      @map("total_questions")
  correctQuestions Int      @map("correct_questions")
  levelBreakdown   Json     @map("level_breakdown")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, skillId], map: "assessment_skill_results_assessment_skill_unique")
  @@index([skillId], map: "assessment_skill_results_skill_idx")
  @@map("assessment_skill_results")
}

model AssessmentQuestionItem {
  id           String   @id @default(cuid())
  assessmentId String   @map("assessment_id")
  questionId   String   @map("question_id")
  skillId      String   @map("skill_id")
  orderIndex   Int      @default(0) @map("order_index")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  skill      Skill              @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, questionId], map: "assessment_question_items_assessment_question_unique")
  @@index([assessmentId, orderIndex], map: "assessment_question_items_assessment_order_idx")
  @@index([skillId], map: "assessment_question_items_skill_idx")
  @@map("assessment_question_items")
}

// ---------------------------------------------------------------------------
// Career Goal Module
// ---------------------------------------------------------------------------

model CareerGoal {
  id          String        @id @default(cuid())
  name        String        @unique(map: "career_goals_name_unique") @db.VarChar(150)
  description String?       @db.Text
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  requiredSkills          CareerRequiredSkill[]
  specializations         Specialization[]
  studentProfiles         StudentProfile[]
  analysisResults         CompetencyAnalysisResult[]
  recommendationTemplates RecommendationTemplate[]
  roadmaps                DevelopmentRoadmap[]
  assessments             Assessment[]

  @@index([status, name], map: "career_goals_status_name_idx")
  @@map("career_goals")
}

model Specialization {
  id           String        @id @default(cuid())
  careerGoalId String        @map("career_goal_id")
  name         String        @db.VarChar(150)
  description  String?       @db.Text
  status       CatalogStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  careerGoal              CareerGoal                 @relation(fields: [careerGoalId], references: [id], onDelete: Cascade)
  requiredSkills          CareerRequiredSkill[]
  studentProfiles         StudentProfile[]
  analysisResults         CompetencyAnalysisResult[]
  recommendationTemplates RecommendationTemplate[]
  roadmaps                DevelopmentRoadmap[]

  @@unique([careerGoalId, name], map: "specializations_career_goal_name_unique")
  @@index([careerGoalId, status], map: "specializations_career_goal_status_idx")
  @@index([status, name], map: "specializations_status_name_idx")
  @@map("specializations")
}

model CareerRequiredSkill {
  id               String       @id @default(cuid())
  careerGoalId     String       @map("career_goal_id")
  specializationId String?      @map("specialization_id")
  skillId          String       @map("skill_id")
  requiredLevel    Int          @map("required_level")
  weight           Decimal      @db.Decimal(6, 2)
  learningOrder    Int          @default(0) @map("learning_order")
  isRequired       Boolean      @default(true) @map("is_required")
  roadmapPhase     RoadmapPhase @default(CAREER_TRACK) @map("roadmap_phase")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  careerGoal     CareerGoal      @relation(fields: [careerGoalId], references: [id], onDelete: Cascade)
  specialization Specialization? @relation(fields: [specializationId], references: [id], onDelete: Cascade)
  skill          Skill           @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([careerGoalId, specializationId, skillId], map: "career_required_skills_goal_specialization_skill_unique")
  @@index([careerGoalId, specializationId, learningOrder], map: "career_required_skills_scope_order_idx")
  @@index([careerGoalId, skillId], map: "career_required_skills_goal_skill_idx")
  @@index([specializationId, skillId], map: "career_required_skills_specialization_skill_idx")
  @@index([skillId, roadmapPhase], map: "career_required_skills_skill_phase_idx")
  @@map("career_required_skills")
}

// ---------------------------------------------------------------------------
// Student Profile Module
// ---------------------------------------------------------------------------

model StudentProfile {
  id                String    @id @default(cuid())
  studentId         String    @unique(map: "student_profiles_student_id_unique") @map("student_id")
  careerGoalId      String?   @map("career_goal_id")
  specializationId  String?   @map("specialization_id")
  summary           String?   @db.Text
  githubUrl         String?   @map("github_url") @db.VarChar(500)
  linkedinUrl       String?   @map("linkedin_url") @db.VarChar(500)
  portfolioUrl      String?   @map("portfolio_url") @db.VarChar(500)
  completionPercent Decimal   @default(0) @map("completion_percent") @db.Decimal(5, 2)
  matchPercent      Decimal   @default(0) @map("match_percent") @db.Decimal(5, 2)
  riskScore         Int       @default(0) @map("risk_score")
  lastAnalyzedAt    DateTime? @map("last_analyzed_at")
  lastUpdatedAt     DateTime? @map("last_updated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  careerGoal     CareerGoal?     @relation(fields: [careerGoalId], references: [id], onDelete: SetNull)
  specialization Specialization? @relation(fields: [specializationId], references: [id], onDelete: SetNull)

  @@index([careerGoalId], map: "student_profiles_career_goal_idx")
  @@index([specializationId], map: "student_profiles_specialization_idx")
  @@index([careerGoalId, specializationId], map: "student_profiles_goal_specialization_idx")
  @@index([completionPercent], map: "student_profiles_completion_percent_idx")
  @@index([matchPercent], map: "student_profiles_match_percent_idx")
  @@index([riskScore], map: "student_profiles_risk_score_idx")
  @@index([lastUpdatedAt], map: "student_profiles_last_updated_at_idx")
  @@map("student_profiles")
}

model StudentSkill {
  id             String             @id @default(cuid())
  studentId      String             @map("student_id")
  skillId        String             @map("skill_id")
  currentLevel   Int                @map("current_level")
  description    String?            @db.Text
  evidenceStatus VerificationStatus @default(NO_EVIDENCE) @map("evidence_status")
  verifiedById   String?            @map("verified_by")
  verifiedAt     DateTime?          @map("verified_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill      Skill   @relation(fields: [skillId], references: [id], onDelete: Restrict)
  verifiedBy User?   @relation("StudentSkillVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([studentId, skillId], map: "student_skills_student_skill_unique")
  @@index([studentId, evidenceStatus], map: "student_skills_student_evidence_status_idx")
  @@index([skillId, currentLevel], map: "student_skills_skill_level_idx")
  @@index([updatedAt], map: "student_skills_updated_at_idx")
  @@map("student_skills")
}

model StudentProject {
  id                 String             @id @default(cuid())
  studentId          String             @map("student_id")
  title              String             @db.VarChar(200)
  description        String?            @db.Text
  roleInProject      String?            @map("role_in_project") @db.VarChar(150)
  technologies       String[]           @default([])
  githubUrl          String?            @map("github_url") @db.VarChar(500)
  demoUrl            String?            @map("demo_url") @db.VarChar(500)
  startDate          DateTime?          @map("start_date") @db.Date
  endDate            DateTime?          @map("end_date") @db.Date
  status             ProjectStatus      @default(IN_PROGRESS)
  verificationStatus VerificationStatus @default(NO_EVIDENCE) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, verificationStatus], map: "student_projects_student_verification_idx")
  @@index([studentId, status], map: "student_projects_student_status_idx")
  @@index([title], map: "student_projects_title_idx")
  @@index([createdAt], map: "student_projects_created_at_idx")
  @@map("student_projects")
}

model StudentCertificate {
  id                 String             @id @default(cuid())
  studentId          String             @map("student_id")
  certificateName    String             @map("certificate_name") @db.VarChar(200)
  issuer             String?            @db.VarChar(200)
  issueDate          DateTime?          @map("issue_date") @db.Date
  expirationDate     DateTime?          @map("expiration_date") @db.Date
  credentialId       String?            @map("credential_id") @db.VarChar(150)
  credentialUrl      String?            @map("credential_url") @db.VarChar(500)
  verificationStatus VerificationStatus @default(NO_EVIDENCE) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, verificationStatus], map: "student_certificates_student_verification_idx")
  @@index([certificateName], map: "student_certificates_name_idx")
  @@index([issuer], map: "student_certificates_issuer_idx")
  @@index([issueDate], map: "student_certificates_issue_date_idx")
  @@map("student_certificates")
}

model StudentActivity {
  id                 String             @id @default(cuid())
  studentId          String             @map("student_id")
  title              String             @db.VarChar(200)
  organization       String?            @db.VarChar(200)
  role               String?            @db.VarChar(150)
  description        String?            @db.Text
  startDate          DateTime?          @map("start_date") @db.Date
  endDate            DateTime?          @map("end_date") @db.Date
  verificationStatus VerificationStatus @default(NO_EVIDENCE) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, verificationStatus], map: "student_activities_student_verification_idx")
  @@index([title], map: "student_activities_title_idx")
  @@index([organization], map: "student_activities_organization_idx")
  @@index([createdAt], map: "student_activities_created_at_idx")
  @@map("student_activities")
}

model StudentExperience {
  id                 String             @id @default(cuid())
  studentId          String             @map("student_id")
  companyName        String             @map("company_name") @db.VarChar(200)
  position           String             @db.VarChar(150)
  description        String?            @db.Text
  startDate          DateTime?          @map("start_date") @db.Date
  endDate            DateTime?          @map("end_date") @db.Date
  verificationStatus VerificationStatus @default(NO_EVIDENCE) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, verificationStatus], map: "student_experiences_student_verification_idx")
  @@index([companyName], map: "student_experiences_company_idx")
  @@index([position], map: "student_experiences_position_idx")
  @@index([createdAt], map: "student_experiences_created_at_idx")
  @@map("student_experiences")
}

model Evidence {
  id                String             @id @default(cuid())
  studentId         String             @map("student_id")
  relatedEntityType EvidenceEntityType @map("related_entity_type")
  relatedEntityId   String             @map("related_entity_id")
  fileUrl           String?            @map("file_url") @db.VarChar(500)
  evidenceUrl       String?            @map("evidence_url") @db.VarChar(500)
  note              String?            @db.Text
  status            EvidenceStatus     @default(PENDING)
  reviewedById      String?            @map("reviewed_by")
  reviewedAt        DateTime?          @map("reviewed_at")
  reviewerNote      String?            @map("reviewer_note") @db.Text
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("EvidenceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([studentId, status], map: "evidences_student_status_idx")
  @@index([relatedEntityType, relatedEntityId], map: "evidences_related_entity_idx")
  @@index([status, createdAt], map: "evidences_status_created_at_idx")
  @@index([reviewedById, reviewedAt], map: "evidences_reviewer_reviewed_at_idx")
  @@map("evidences")
}

model AdvisorReview {
  id            String   @id @default(cuid())
  studentId     String   @map("student_id")
  lecturerId    String   @map("lecturer_id")
  reviewContent String   @map("review_content") @db.Text
  suggestion    String?  @db.Text
  rating        Int?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lecturer Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt], map: "advisor_reviews_student_created_at_idx")
  @@index([lecturerId, createdAt], map: "advisor_reviews_lecturer_created_at_idx")
  @@map("advisor_reviews")
}

// ---------------------------------------------------------------------------
// Competency Analysis Module
// ---------------------------------------------------------------------------

model CompetencyAnalysisResult {
  id                String     @id @default(cuid())
  studentId         String     @map("student_id")
  careerGoalId      String     @map("career_goal_id")
  specializationId  String?    @map("specialization_id")
  completionPercent Decimal    @map("completion_percent") @db.Decimal(5, 2)
  matchPercent      Decimal    @map("match_percent") @db.Decimal(5, 2)
  riskScore         Int        @map("risk_score")
  matchLevel        MatchLevel @map("match_level")
  analyzedAt        DateTime   @default(now()) @map("analyzed_at")

  student         Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  careerGoal      CareerGoal                 @relation(fields: [careerGoalId], references: [id], onDelete: Restrict)
  specialization  Specialization?            @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  details         CompetencyAnalysisDetail[]
  recommendations StudentRecommendation[]

  @@index([studentId, analyzedAt], map: "analysis_results_student_analyzed_at_idx")
  @@index([careerGoalId, matchLevel], map: "analysis_results_goal_match_level_idx")
  @@index([specializationId, matchLevel], map: "analysis_results_specialization_match_idx")
  @@index([matchPercent], map: "analysis_results_match_percent_idx")
  @@index([riskScore], map: "analysis_results_risk_score_idx")
  @@map("competency_analysis_results")
}

model CompetencyAnalysisDetail {
  id               String              @id @default(cuid())
  analysisResultId String              @map("analysis_result_id")
  skillId          String              @map("skill_id")
  currentLevel     Int                 @map("current_level")
  requiredLevel    Int                 @map("required_level")
  gap              Int
  weight           Decimal             @db.Decimal(6, 2)
  achievedScore    Decimal             @map("achieved_score") @db.Decimal(6, 2)
  priorityScore    Decimal             @map("priority_score") @db.Decimal(6, 2)
  status           AnalysisSkillStatus

  analysisResult CompetencyAnalysisResult @relation(fields: [analysisResultId], references: [id], onDelete: Cascade)
  skill          Skill                    @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([analysisResultId, skillId], map: "analysis_details_result_skill_unique")
  @@index([skillId, status], map: "analysis_details_skill_status_idx")
  @@index([analysisResultId, status, priorityScore], map: "analysis_details_result_status_priority_idx")
  @@index([analysisResultId, skillId, status], map: "analysis_details_result_skill_status_idx")
  @@map("competency_analysis_details")
}

// ---------------------------------------------------------------------------
// Recommendation Module
// ---------------------------------------------------------------------------

model RecommendationTemplate {
  id                 String             @id @default(cuid())
  skillId            String?            @map("skill_id")
  skillCategoryId    String?            @map("skill_category_id")
  careerGoalId       String?            @map("career_goal_id")
  specializationId   String?            @map("specialization_id")
  level              SkillLevel?
  recommendationType RecommendationType @map("recommendation_type")
  title              String             @db.VarChar(200)
  description        String?            @db.Text
  difficultyLevel    DifficultyLevel?   @map("difficulty_level")
  estimatedDuration  String?            @map("estimated_duration") @db.VarChar(100)
  resourceUrl        String?            @map("resource_url") @db.VarChar(500)
  priority           Int                @default(0)
  roadmapPhase       RoadmapPhase?      @map("roadmap_phase")
  status             TemplateStatus     @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  skill                  Skill?                           @relation(fields: [skillId], references: [id], onDelete: SetNull)
  skillCategory          SkillCategory?                   @relation(fields: [skillCategoryId], references: [id], onDelete: SetNull)
  careerGoal             CareerGoal?                      @relation(fields: [careerGoalId], references: [id], onDelete: Cascade)
  specialization         Specialization?                  @relation(fields: [specializationId], references: [id], onDelete: Cascade)
  studentRecommendations StudentRecommendation[]
  resourceLinks          RecommendationTemplateResource[]

  @@unique([specializationId, careerGoalId, skillCategoryId, skillId, level, recommendationType, roadmapPhase, title], map: "recommendation_templates_scope_unique")
  @@index([skillId], map: "recommendation_templates_skill_idx")
  @@index([skillCategoryId], map: "recommendation_templates_skill_category_idx")
  @@index([careerGoalId], map: "recommendation_templates_career_goal_idx")
  @@index([specializationId], map: "recommendation_templates_specialization_idx")
  @@index([recommendationType], map: "recommendation_templates_type_idx")
  @@index([roadmapPhase], map: "recommendation_templates_phase_idx")
  @@index([status], map: "recommendation_templates_status_idx")
  @@index([specializationId, careerGoalId, skillId, status], map: "recommendation_templates_specialization_goal_skill_idx")
  @@index([careerGoalId, skillId, status], map: "recommendation_templates_goal_skill_idx")
  @@index([skillCategoryId, skillId, status], map: "recommendation_templates_category_skill_idx")
  @@index([skillId, status], map: "recommendation_templates_skill_status_idx")
  @@index([priority], map: "recommendation_templates_priority_idx")
  @@index([title], map: "recommendation_templates_title_idx")
  @@map("recommendation_templates")
}

model StudentRecommendation {
  id                       String                      @id @default(cuid())
  studentId                String                      @map("student_id")
  analysisResultId         String?                     @map("analysis_result_id")
  skillId                  String                      @map("skill_id")
  recommendationTemplateId String?                     @map("recommendation_template_id")
  roadmapPhase             RoadmapPhase?               @map("roadmap_phase")
  title                    String                      @db.VarChar(200)
  description              String?                     @db.Text
  reason                   String?                     @db.Text
  priorityScore            Decimal                     @default(0) @map("priority_score") @db.Decimal(6, 2)
  status                   StudentRecommendationStatus @default(NEW)
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")

  student                Student                         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  analysisResult         CompetencyAnalysisResult?       @relation(fields: [analysisResultId], references: [id], onDelete: SetNull)
  skill                  Skill                           @relation(fields: [skillId], references: [id], onDelete: Restrict)
  recommendationTemplate RecommendationTemplate?         @relation(fields: [recommendationTemplateId], references: [id], onDelete: SetNull)
  roadmapItems           RoadmapItem[]
  resourceLinks          StudentRecommendationResource[]
  resourceProgress       StudentResourceProgress[]

  @@index([studentId, status, createdAt], map: "student_recommendations_student_status_created_idx")
  @@index([analysisResultId], map: "student_recommendations_analysis_result_idx")
  @@index([skillId, priorityScore], map: "student_recommendations_skill_priority_idx")
  @@index([roadmapPhase, status], map: "student_recommendations_phase_status_idx")
  @@map("student_recommendations")
}

model LearningResource {
  id                String               @id @default(cuid())
  title             String               @db.VarChar(200)
  description       String?              @db.Text
  resourceType      LearningResourceType @map("resource_type")
  url               String?              @db.VarChar(500)
  provider          String?              @db.VarChar(150)
  difficultyLevel   DifficultyLevel?     @map("difficulty_level")
  estimatedDuration String?              @map("estimated_duration") @db.VarChar(100)
  language          String?              @db.VarChar(50)
  isFree            Boolean              @default(true) @map("is_free")
  status            CatalogStatus        @default(ACTIVE)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  skills              LearningResourceSkill[]
  templateLinks       RecommendationTemplateResource[]
  recommendationLinks StudentRecommendationResource[]
  progress            StudentResourceProgress[]

  @@index([resourceType, status], map: "learning_resources_type_status_idx")
  @@index([status, title], map: "learning_resources_status_title_idx")
  @@index([provider], map: "learning_resources_provider_idx")
  @@index([title], map: "learning_resources_title_idx")
  @@map("learning_resources")
}

model LearningResourceSkill {
  id             String        @id @default(cuid())
  resourceId     String        @map("resource_id")
  skillId        String        @map("skill_id")
  targetLevel    SkillLevel?   @map("target_level")
  roadmapPhase   RoadmapPhase? @map("roadmap_phase")
  relevanceScore Int           @default(0) @map("relevance_score")
  orderIndex     Int           @default(0) @map("order_index")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  resource LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skill    Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([resourceId, skillId, targetLevel], map: "learning_resource_skills_resource_skill_level_unique")
  @@index([resourceId], map: "learning_resource_skills_resource_idx")
  @@index([skillId], map: "learning_resource_skills_skill_idx")
  @@index([skillId, targetLevel], map: "learning_resource_skills_skill_level_idx")
  @@map("learning_resource_skills")
}

model RecommendationTemplateResource {
  id         String   @id @default(cuid())
  templateId String   @map("template_id")
  resourceId String   @map("resource_id")
  orderIndex Int      @default(0) @map("order_index")
  priority   Int      @default(0)
  isRequired Boolean  @default(false) @map("is_required")
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  template RecommendationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  resource LearningResource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([templateId, resourceId], map: "recommendation_template_resources_template_resource_unique")
  @@index([templateId], map: "recommendation_template_resources_template_idx")
  @@index([resourceId], map: "recommendation_template_resources_resource_idx")
  @@index([templateId, orderIndex], map: "recommendation_template_resources_template_order_idx")
  @@map("recommendation_template_resources")
}

model StudentRecommendationResource {
  id                  String               @id @default(cuid())
  recommendationId    String               @map("recommendation_id")
  resourceId          String               @map("resource_id")
  orderIndex          Int                  @default(0) @map("order_index")
  resourceTitle       String               @map("resource_title") @db.VarChar(200)
  resourceDescription String?              @map("resource_description") @db.Text
  resourceType        LearningResourceType @map("resource_type")
  resourceUrl         String?              @map("resource_url") @db.VarChar(500)
  provider            String?              @db.VarChar(150)
  estimatedDuration   String?              @map("estimated_duration") @db.VarChar(100)
  difficultyLevel     DifficultyLevel?     @map("difficulty_level")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  recommendation StudentRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  resource       LearningResource      @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([recommendationId, resourceId], map: "student_recommendation_resources_recommendation_resource_unique")
  @@index([recommendationId], map: "student_recommendation_resources_recommendation_idx")
  @@index([resourceId], map: "student_recommendation_resources_resource_idx")
  @@index([recommendationId, orderIndex], map: "student_recommendation_resources_recommendation_order_idx")
  @@map("student_recommendation_resources")
}

model StudentResourceProgress {
  id               String                 @id @default(cuid())
  studentId        String                 @map("student_id")
  resourceId       String                 @map("resource_id")
  recommendationId String?                @map("recommendation_id")
  status           ResourceProgressStatus @default(NOT_STARTED)
  startedAt        DateTime?              @map("started_at")
  completedAt      DateTime?              @map("completed_at")
  lastAccessedAt   DateTime?              @map("last_accessed_at")
  note             String?                @db.Text
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  student        Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resource       LearningResource       @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  recommendation StudentRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@unique([studentId, resourceId], map: "student_resource_progress_student_resource_unique")
  @@index([studentId], map: "student_resource_progress_student_idx")
  @@index([resourceId], map: "student_resource_progress_resource_idx")
  @@index([recommendationId], map: "student_resource_progress_recommendation_idx")
  @@index([studentId, status], map: "student_resource_progress_student_status_idx")
  @@map("student_resource_progress")
}

// ---------------------------------------------------------------------------
// Roadmap Module
// ---------------------------------------------------------------------------

model DevelopmentRoadmap {
  id               String        @id @default(cuid())
  studentId        String        @map("student_id")
  careerGoalId     String        @map("career_goal_id")
  specializationId String?       @map("specialization_id")
  version          Int           @default(1)
  title            String        @db.VarChar(200)
  description      String?       @db.Text
  progressPercent  Decimal       @default(0) @map("progress_percent") @db.Decimal(5, 2)
  status           RoadmapStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  student        Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  careerGoal     CareerGoal               @relation(fields: [careerGoalId], references: [id], onDelete: Restrict)
  specialization Specialization?          @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  items          RoadmapItem[]
  progress       StudentRoadmapProgress[]

  @@unique([studentId, version], map: "development_roadmaps_student_version_unique")
  @@index([studentId, status], map: "development_roadmaps_student_status_idx")
  @@index([studentId, version], map: "development_roadmaps_student_version_idx")
  @@index([careerGoalId, status], map: "development_roadmaps_goal_status_idx")
  @@index([specializationId, status], map: "development_roadmaps_specialization_status_idx")
  @@index([createdAt], map: "development_roadmaps_created_at_idx")
  @@map("development_roadmaps")
}

model RoadmapItem {
  id               String            @id @default(cuid())
  roadmapId        String            @map("roadmap_id")
  skillId          String?           @map("skill_id")
  recommendationId String?           @map("recommendation_id")
  title            String            @db.VarChar(200)
  description      String?           @db.Text
  itemType         RoadmapItemType   @map("item_type")
  roadmapPhase     RoadmapPhase      @default(CAREER_TRACK) @map("roadmap_phase")
  orderIndex       Int               @default(0) @map("order_index")
  weight           Decimal           @default(1) @db.Decimal(6, 2)
  deadline         DateTime?         @db.Date
  status           RoadmapItemStatus @default(TODO)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  roadmap        DevelopmentRoadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  skill          Skill?                   @relation(fields: [skillId], references: [id], onDelete: SetNull)
  recommendation StudentRecommendation?   @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  progress       StudentRoadmapProgress[]

  @@index([roadmapId, orderIndex], map: "roadmap_items_roadmap_order_idx")
  @@index([roadmapId, status], map: "roadmap_items_roadmap_status_idx")
  @@index([roadmapId, roadmapPhase, orderIndex], map: "roadmap_items_roadmap_phase_order_idx")
  @@index([roadmapId, roadmapPhase, status], map: "roadmap_items_roadmap_phase_status_idx")
  @@index([skillId, roadmapPhase], map: "roadmap_items_skill_phase_idx")
  @@index([recommendationId], map: "roadmap_items_recommendation_idx")
  @@index([deadline], map: "roadmap_items_deadline_idx")
  @@map("roadmap_items")
}

model StudentRoadmapProgress {
  id            String            @id @default(cuid())
  studentId     String            @map("student_id")
  roadmapId     String            @map("roadmap_id")
  roadmapItemId String            @map("roadmap_item_id")
  status        RoadmapItemStatus
  note          String?           @db.Text
  updatedAt     DateTime          @default(now()) @map("updated_at")

  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roadmap     DevelopmentRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  roadmapItem RoadmapItem        @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)

  @@index([studentId, updatedAt], map: "student_roadmap_progress_student_updated_idx")
  @@index([roadmapId, status], map: "student_roadmap_progress_roadmap_status_idx")
  @@index([roadmapItemId, updatedAt], map: "student_roadmap_progress_item_updated_idx")
  @@map("student_roadmap_progress")
}

// ---------------------------------------------------------------------------
// Notification Module
// ---------------------------------------------------------------------------

model Notification {
  id                String           @id @default(cuid())
  userId            String           @map("user_id")
  title             String           @db.VarChar(200)
  content           String           @db.Text
  notificationType  NotificationType @map("notification_type")
  relatedEntityType String?          @map("related_entity_type") @db.VarChar(100)
  relatedEntityId   String?          @map("related_entity_id")
  isRead            Boolean          @default(false) @map("is_read")
  createdAt         DateTime         @default(now()) @map("created_at")

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs NotificationLog[]

  @@index([userId, isRead, createdAt], map: "notifications_user_read_created_idx")
  @@index([notificationType, createdAt], map: "notifications_type_created_at_idx")
  @@index([relatedEntityType, relatedEntityId], map: "notifications_related_entity_idx")
  @@map("notifications")
}

model NotificationLog {
  id             String                @id @default(cuid())
  notificationId String                @map("notification_id")
  userId         String                @map("user_id")
  channel        NotificationChannel
  status         NotificationLogStatus @default(PENDING)
  sentAt         DateTime?             @map("sent_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationId], map: "notification_logs_notification_idx")
  @@index([userId, status], map: "notification_logs_user_status_idx")
  @@index([sentAt], map: "notification_logs_sent_at_idx")
  @@map("notification_logs")
}

