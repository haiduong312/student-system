  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "activity_logs_user_created_at_idx")
  @@index([entityType, entityId], map: "activity_logs_entity_idx")
  @@index([action, createdAt], map: "activity_logs_action_created_at_idx")
  @@map("activity_logs")
}

model ExportLog {
  id         String     @id @default(cuid())
  userId     String?    @map("user_id")
  exportType ExportType @map("export_type")
  fileUrl    String?    @map("file_url") @db.VarChar(500)
  createdAt  DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "export_logs_user_created_at_idx")
